# Choose one (or none, for offline/deterministic-only mode)
LLM_PROVIDER=ollama          # one of: openai, anthropic, ollama
LLM_MODEL=llama3.1:8b        # provider-specific model name
LLM_TEMPERATURE=0

# Provider keys (only needed for non-local providers)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local Ollama endpoint (default)
OLLAMA_HOST=http://localhost:11434

# Ollama per-request timeout in seconds (default 120). Set 900 for CPU Ollama:
# the 120s default times out large LLM calls and silently degrades the report
# (empty Bull/Bear rounds, "Heuristic"/"backfilled" notes). GPU users can leave default.
OLLAMA_TIMEOUT=900

# Cache directory for data layer (defaults to ./.fra_cache)
FRA_CACHE_DIR=
